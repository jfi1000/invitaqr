# Base de datos
DB_NAME=invitaqr
DB_USER=invitaqr_user
DB_PASSWORD=cambia-esta-clave-de-postgres
DB_HOST=postgres
DB_PORT=5432

# JWT — tokens de sesión
JWT_SECRET=cambia-este-secreto-jwt-de-produccion-min-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-este-secreto-refresh-de-produccion-min-32
JWT_REFRESH_EXPIRES_IN=7d

# JWT — tokens QR (secreto DISTINTO al de sesión)
QR_JWT_SECRET=cambia-este-secreto-qr-distinto-al-de-sesion
QR_JWT_EXPIRES_IN=30d

# Cuenta OWNER de Xalapasoft (se crea al arrancar si el correo no existe)
OWNER_NAME=Xalapasoft
OWNER_EMAIL=admin@invitaqr.com
OWNER_PASSWORD=cambia-esta-clave-owner

# Stripe
STRIPE_SECRET_KEY=sk_live_cambia_esta_clave
STRIPE_WEBHOOK_SECRET=whsec_cambia_este_secreto
STRIPE_PRICE_BASIC=price_basic_produccion
STRIPE_PRICE_PRO=price_pro_produccion

# WhatsApp Business (360dialog)
WHATSAPP_API_KEY=cambia-esta-api-key
WHATSAPP_PHONE_ID=cambia-este-phone-id
WHATSAPP_BASE_URL=https://waba.360dialog.io/v1

# Email (SMTP)
SMTP_HOST=smtp.invitaqr.com
SMTP_PORT=587
SMTP_USER=noreply@invitaqr.com
SMTP_PASS=cambia-esta-clave-smtp
SMTP_FROM="InvitaQR <noreply@invitaqr.com>"

# URLs
