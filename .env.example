# Base de datos
DB_NAME=invitaqr
DB_USER=invitaqr_user
DB_PASSWORD=supersecret
DB_HOST=postgres
DB_PORT=5432

# JWT — tokens de sesión
JWT_SECRET=jwt_secret_aqui_minimo_16
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refresh_secret_aqui_minimo_16
JWT_REFRESH_EXPIRES_IN=7d

# JWT — tokens QR (secreto DISTINTO al de sesión)
QR_JWT_SECRET=qr_secret_diferente_aqui
QR_JWT_EXPIRES_IN=30d

# Cuenta OWNER de Xalapasoft (se crea al arrancar si el correo no existe)
OWNER_NAME=Xalapasoft
OWNER_EMAIL=admin@xalapasoft.com
OWNER_PASSWORD=cambia-esta-clave

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...

# WhatsApp Business (360dialog)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=
WHATSAPP_BASE_URL=https://waba.360dialog.io/v1

# Email (SMTP)
# Puerto 465 = SSL directo (Nodemailer usa secure: true cuando port === 465)
# Puerto 587 = STARTTLS (secure: false)
SMTP_HOST=mail.softcompany.online
SMTP_PORT=465
SMTP_USER=invitaqr@softcompany.online
SMTP_PASS=
SMTP_FROM=InvitaQR <invitaqr@softcompany.online>

# URLs
# APP_URL: base de la app (links RSVP → {APP_URL}/rsvp/{token})
APP_URL=http://localhost:8081
API_URL=http://localhost:3000

# Entorno
NODE_ENV=development
PORT=3000
