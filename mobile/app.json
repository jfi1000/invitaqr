{
  "expo": {
    "name": "InvitaQR",
    "slug": "invitaqr",
    "scheme": "invitaqr",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xalapasoft.invitaqr"
    },
    "android": {
      "package": "com.xalapasoft.invitaqr",
      "adaptiveIcon": {
        "backgroundColor": "#f6f1e8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f1e8",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:3000"
    }
  }
}
