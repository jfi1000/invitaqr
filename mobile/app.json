{
  "expo": {
    "name": "InvitaQR",
    "slug": "invitaqr",
    "scheme": "invitaqr",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f6f1e8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xalapasoft.invitaqr"
    },
    "android": {
      "package": "com.xalapasoft.invitaqr",
      "adaptiveIcon": {
        "backgroundColor": "#f6f1e8"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:3000"
    }
  }
}
