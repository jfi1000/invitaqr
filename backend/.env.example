# Copia estas variables al .env de la raíz del monorepo (../.env).
# Nest carga envFilePath: ['../.env', '.env']

# Email (SMTP)
# Puerto 465 = SSL directo (Nodemailer: secure: true cuando port === 465)
SMTP_HOST=mail.softcompany.online
SMTP_PORT=465
SMTP_USER=invitaqr@softcompany.online
SMTP_PASS=
SMTP_FROM=InvitaQR <invitaqr@softcompany.online>

# Base de la app móvil/web — links de invitación RSVP
APP_URL=http://localhost:8081

# Secreto JWT para tokens QR (DISTINTO al JWT de sesión)
QR_JWT_SECRET=genera-un-string-aleatorio-seguro-aqui
QR_JWT_EXPIRES_IN=30d
